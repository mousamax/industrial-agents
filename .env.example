# Copy to .env (never commit .env). Everything here is optional except the model key.

# --- Models -------------------------------------------------------------------
# Set one. Once ANTHROPIC_API_KEY is set, OpenRouter is never used for the aliases.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Aliases (smart/balanced/fast/judge) map to Claude Opus/Sonnet/Haiku 5.5 on either provider
# (src/app/models.py). Override one for yourself or for an eval run:
# MODEL_SMART=openrouter:openai/gpt-6.1-sol

# --- Tracing (Langfuse) --------------------------------------------------------
# One Langfuse project for the team; keys from Project Settings -> API Keys. Leave empty to trace nothing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Your name: becomes the Langfuse user, so you can filter your own traces (e.g. "mousa").
APP_ENV=dev
DEV_NAME=

# --- Partner APIs (fill in after the track briefing) ----------------------------
# TACTO_API_KEY=
# SYNERA_API_KEY=
# CERTIVITY_API_KEY=
