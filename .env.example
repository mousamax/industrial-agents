# Copy to .env (never commit .env). Everything here is optional except the model key.

# --- Models -------------------------------------------------------------------
# Set one. With both set, Anthropic wins unless MODEL_PROVIDER=openrouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# MODEL_PROVIDER=openrouter

# Aliases (smart/balanced/fast/judge) map to Claude Opus/Sonnet/Haiku 5.5 on either provider
# (src/app/models.py). Override one for yourself or for an eval run:
# MODEL_SMART=openrouter:openai/gpt-6.1-sol

# --- Tracing ------------------------------------------------------------------
# Logfire: create a project at https://logfire.pydantic.dev and paste a WRITE token.
# Share ONE project token with the whole team so everyone sees everyone's traces.
LOGFIRE_TOKEN=

# Langfuse (optional, in addition to or instead of Logfire). Traces are exported over OTLP.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tag your traces so the team can filter by person: e.g. "mousa", "anna".
APP_ENV=dev
DEV_NAME=

# --- Partner APIs (fill in after the track briefing) ----------------------------
# TACTO_API_KEY=
# SYNERA_API_KEY=
# CERTIVITY_API_KEY=
